(export
	(version "E")
	(components
		(comp
			(ref "U1")
			(value "NE555")
			(libsource (lib "Timer") (part "NE555"))
		)
		(comp
			(ref "Q1")
			(value "IRLZ44N")
			(libsource (lib "Transistor_FET") (part "IRLZ44N"))
		)
		(comp
			(ref "D1")
			(value "1N5819")
			(libsource (lib "Diode") (part "D_Schottky"))
		)
		(comp
			(ref "R1")
			(value "100")
			(libsource (lib "Device") (part "R"))
		)
		(comp
			(ref "R2")
			(value "10k")
			(libsource (lib "Device") (part "R"))
		)
		(comp
			(ref "R3")
			(value "1k")
			(libsource (lib "Device") (part "R"))
		)
		(comp
			(ref "C1")
			(value "10nF")
			(libsource (lib "Device") (part "C"))
		)
		(comp
			(ref "C2")
			(value "100uF")
			(libsource (lib "Device") (part "C_Polarized"))
		)
		(comp
			(ref "J1")
			(value "Conn_01x02")
			(libsource (lib "Connector_Generic") (part "Conn_01x02"))
		)
		(comp
			(ref "J2")
			(value "Conn_01x02")
			(libsource (lib "Connector_Generic") (part "Conn_01x02"))
		)
	)
	(libparts
		(libpart
			(lib "Timer")
			(part "NE555")
			(pins
				(pin (num "1") (name "GND") (type "power"))
				(pin (num "2") (name "TR") (type "input"))
				(pin (num "3") (name "Q") (type "output"))
				(pin (num "4") (name "R") (type "input"))
				(pin (num "5") (name "CV") (type "input"))
				(pin (num "6") (name "THR") (type "input"))
				(pin (num "7") (name "DIS") (type "input"))
				(pin (num "8") (name "VCC") (type "power"))
			)
		)
		(libpart
			(lib "Transistor_FET")
			(part "IRLZ44N")
			(pins
				(pin (num "1") (name "G") (type "input"))
				(pin (num "2") (name "D") (type "passive"))
				(pin (num "3") (name "S") (type "passive"))
			)
		)
		(libpart
			(lib "Diode")
			(part "D_Schottky")
			(pins
				(pin (num "1") (name "K") (type "passive"))
				(pin (num "2") (name "A") (type "passive"))
			)
		)
		(libpart
			(lib "Device")
			(part "R")
			(pins
				(pin (num "1") (name "~") (type "passive"))
				(pin (num "2") (name "~") (type "passive"))
			)
		)
		(libpart
			(lib "Device")
			(part "C")
			(pins
				(pin (num "1") (name "~") (type "passive"))
				(pin (num "2") (name "~") (type "passive"))
			)
		)
		(libpart
			(lib "Device")
			(part "C_Polarized")
			(pins
				(pin (num "1") (name "+") (type "passive"))
				(pin (num "2") (name "-") (type "passive"))
			)
		)
		(libpart
			(lib "Connector_Generic")
			(part "Conn_01x02")
			(pins
				(pin (num "1") (name "Pin_1") (type "passive"))
				(pin (num "2") (name "Pin_2") (type "passive"))
			)
		)
	)
	(nets
		(net
			(name "+12V")
			(node (ref "J1") (pin "1"))
			(node (ref "U1") (pin "8"))
			(node (ref "U1") (pin "4"))
			(node (ref "C2") (pin "1"))
			(node (ref "D1") (pin "1"))
		)
		(net
			(name "GND")
			(node (ref "J1") (pin "2"))
			(node (ref "U1") (pin "1"))
			(node (ref "C1") (pin "2"))
			(node (ref "C2") (pin "2"))
			(node (ref "Q1") (pin "3"))
		)
		(net
			(name "OSC_TIMING")
			(node (ref "R1") (pin "1"))
			(node (ref "R1") (pin "2"))
			(node (ref "U1") (pin "7"))
			(node (ref "U1") (pin "2"))
			(node (ref "U1") (pin "6"))
			(node (ref "C1") (pin "1"))
		)
		(net
			(name "PWM_OUT")
			(node (ref "U1") (pin "3"))
			(node (ref "R3") (pin "1"))
		)
		(net
			(name "MOSFET_GATE")
			(node (ref "R3") (pin "2"))
			(node (ref "R2") (pin "1"))
			(node (ref "Q1") (pin "1"))
		)
		(net
			(name "GATE_PULLDOWN")
			(node (ref "R2") (pin "2"))
		)
		(net
			(name "MOTOR_NEG")
			(node (ref "Q1") (pin "2"))
			(node (ref "D1") (pin "2"))
			(node (ref "J2") (pin "2"))
		)
		(net
			(name "MOTOR_POS")
			(node (ref "J2") (pin "1"))
		)
	)
)
