			(node (ref "U1") (pin "1"))
			(node (ref "R1") (pin "2"))
			(node (ref "J1") (pin "3"))
		)
		(net
			(name "XTAL1")
			(node (ref "U1") (pin "9"))
			(node (ref "Y1") (pin "1"))
			(node (ref "C2") (pin "1"))
