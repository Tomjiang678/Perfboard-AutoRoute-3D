(export
	(version "E")
	(components
		(comp
			(ref "U1")
			(value "ATmega328P-PU")
			(libsource (lib "MCU_Microchip_ATmega") (part "ATmega328P-PU"))
		)
		(comp
			(ref "R1")
			(value "10k")
			(libsource (lib "Device") (part "R"))
		)
		(comp
			(ref "C1")
			(value "100nF")
			(libsource (lib "Device") (part "C"))
		)
		(comp
			(ref "C2")
			(value "22pF")
			(libsource (lib "Device") (part "C"))
		)
		(comp
			(ref "C3")
			(value "22pF")
			(libsource (lib "Device") (part "C"))
		)
		(comp
			(ref "Y1")
			(value "16MHz")
			(libsource (lib "Device") (part "Crystal"))
		)
		(comp
			(ref "J1")
			(value "Conn_01x06")
			(libsource (lib "Connector_Generic") (part "Conn_01x06"))
		)
	)
	(libparts
		(libpart
			(lib "MCU_Microchip_ATmega")
			(part "ATmega328P-PU")
			(pins
				(pin (num "1") (name "PC6/RESET") (type "input"))
				(pin (num "2") (name "PD0/RXD") (type "bidirectional"))
				(pin (num "3") (name "PD1/TXD") (type "bidirectional"))
