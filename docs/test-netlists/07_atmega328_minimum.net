	(nets
		(net
			(name "+5V")
			(node (ref "U1") (pin "7"))
			(node (ref "U1") (pin "20"))
			(node (ref "R1") (pin "1"))
			(node (ref "C1") (pin "1"))
			(node (ref "J1") (pin "1"))
