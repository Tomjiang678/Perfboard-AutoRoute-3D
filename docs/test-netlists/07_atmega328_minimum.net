				(pin (num "5") (name "PD3") (type "bidirectional"))
				(pin (num "6") (name "PD4") (type "bidirectional"))
				(pin (num "7") (name "VCC") (type "power"))
				(pin (num "8") (name "GND") (type "power"))
				(pin (num "9") (name "PB6/XTAL1") (type "input"))
				(pin (num "10") (name "PB7/XTAL2") (type "output"))
				(pin (num "11") (name "PD5") (type "bidirectional"))
				(pin (num "12") (name "PD6") (type "bidirectional"))
				(pin (num "13") (name "PD7") (type "bidirectional"))
				(pin (num "14") (name "PB0") (type "bidirectional"))
				(pin (num "15") (name "PB1") (type "bidirectional"))
				(pin (num "16") (name "PB2") (type "bidirectional"))
				(pin (num "17") (name "PB3/MOSI") (type "bidirectional"))
				(pin (num "18") (name "PB4/MISO") (type "bidirectional"))
				(pin (num "19") (name "PB5/SCK") (type "bidirectional"))
				(pin (num "20") (name "AVCC") (type "power"))
				(pin (num "21") (name "AREF") (type "input"))
				(pin (num "22") (name "GND2") (type "power"))
				(pin (num "23") (name "PC0") (type "bidirectional"))
				(pin (num "24") (name "PC1") (type "bidirectional"))
				(pin (num "25") (name "PC2") (type "bidirectional"))
				(pin (num "26") (name "PC3") (type "bidirectional"))
				(pin (num "27") (name "PC4/SDA") (type "bidirectional"))
				(pin (num "28") (name "PC5/SCL") (type "bidirectional"))
			)
		)
		(libpart
			(lib "Device")
			(part "R")
			(pins
				(pin (num "1") (name "~") (type "passive"))
				(pin (num "2") (name "~") (type "passive"))
			)
		)
		(libpart
			(lib "Device")
			(part "C")
			(pins
				(pin (num "1") (name "~") (type "passive"))
				(pin (num "2") (name "~") (type "passive"))
			)
		)
		(libpart
			(lib "Device")
			(part "Crystal")
			(pins
				(pin (num "1") (name "~") (type "passive"))
				(pin (num "2") (name "~") (type "passive"))
			)
		)
		(libpart
			(lib "Connector_Generic")
			(part "Conn_01x06")
			(pins
				(pin (num "1") (name "Pin_1") (type "passive"))
				(pin (num "2") (name "Pin_2") (type "passive"))
				(pin (num "3") (name "Pin_3") (type "passive"))
				(pin (num "4") (name "Pin_4") (type "passive"))
				(pin (num "5") (name "Pin_5") (type "passive"))
				(pin (num "6") (name "Pin_6") (type "passive"))
			)
		)
