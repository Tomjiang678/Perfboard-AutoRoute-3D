{
  "name": "@perfboard-autoroute/web",
  "version": "0.1.0",
  "description": "A 3D perfboard component placement, routing, jumper planning, and DRC tool.",
  "author": "zhuohan jiang",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.perfboard.autoroute3d",
    "productName": "ProtoRoute 3D",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "icon": "assets/image1.ico"
    }
  }
}
