{
  "componentMappingRules": [
    {
      "kind": "led",
      "label": "LED",
      "leadSpacing": 1,
      "match": [
        { "field": "refPrefix", "equals": "LED" },
        { "field": "category", "includes": "LED" }
      ]
    },
    {
      "kind": "potentiometer",
      "label": "RV",
      "match": [
        { "field": "refPrefix", "equals": "RV" },
        { "field": "value", "includes": "POT" },
        { "field": "category", "includes": "POT" },
        { "field": "value", "includes": "POTENTIOMETER" },
        { "field": "category", "includes": "POTENTIOMETER" },
        { "field": "value", "includes": "VARIABLE_RESISTOR" },
        { "field": "category", "includes": "VARIABLE_RESISTOR" }
      ]
    },
    {
      "kind": "resistor",
      "label": "R",
      "leadSpacing": 3,
      "match": [
        { "field": "refPrefix", "equals": "R" },
        { "field": "category", "includes": "RESISTOR" }
      ]
    },
    {
      "kind": "inductor",
      "label": "L",
      "leadSpacing": 3,
      "match": [
        { "field": "refPrefix", "equals": "L" },
        { "field": "category", "includes": "INDUCTOR" }
      ]
    },
    {
      "kind": "diode",
      "label": "D",
      "leadSpacing": 3,
      "match": [
        { "field": "refPrefix", "equals": "D" },
        { "field": "category", "includes": "DIODE" },
        { "field": "category", "includes": "ZENER" },
        { "field": "value", "includes": "PHOTO_DIODE" }
      ]
    },
    {
      "kind": "dip",
      "label": "DIP",
      "rowSpacing": 3,
      "pinCountStrategy": "fixed8",
      "match": [
        { "field": "value", "matches": "^LM358(?:[A-Z0-9_+-]*)" }
      ]
    },
    {
      "kind": "dip_switch",
      "label": "DIPSW",
      "rowSpacing": 3,
      "pinCountStrategy": "dipSwitch",
      "match": [
        { "field": "value", "includes": "DIPSW" },
        { "field": "packageName", "includes": "DIPSW" }
      ]
    },
    {
      "kind": "dip",
      "label": "DIP",
      "rowSpacing": 3,
      "pinCountStrategy": "dipPackage",
      "matchMode": "all",
      "match": [
        { "field": "value", "matches": "(^|[^A-Z0-9])(?:NE|LM|TLC)?555[A-Z0-9_-]*(?:[^A-Z0-9]|$)" },
        {
          "any": [
            { "field": "refPrefix", "equals": "U" },
            { "field": "refPrefix", "equals": "A" },
            { "field": "category", "includes": "TIMER" },
            { "field": "category", "includes": "IC" },
            { "field": "category", "includes": "MIXED_VIRTUAL" }
          ]
        }
      ]
    },
    {
      "kind": "to220",
      "label": "Q",
      "pinCountStrategy": "fixed3",
      "match": [
        { "field": "packageName", "includes": "TO-220" },
        { "field": "packageName", "includes": "TO220" }
      ]
    },
    {
      "kind": "to92",
      "label": "Q",
      "pinCountStrategy": "fixed3",
      "match": [
        { "field": "packageName", "includes": "TO-92" },
        { "field": "packageName", "includes": "TO92" }
      ]
    },
    {
      "kind": "to39",
      "label": "Q",
      "pinCountStrategy": "fixed3",
      "match": [
        { "field": "packageName", "includes": "TO-39" },
        { "field": "packageName", "includes": "TO39" }
      ]
    },
    {
      "kind": "to92",
      "label": "Q",
      "pinCountStrategy": "fixed3",
      "matchMode": "all",
      "match": [
        { "field": "refPrefix", "equals": "Q" },
        {
          "any": [
            { "field": "category", "includes": "BJT" },
            { "field": "category", "includes": "TRANSISTOR" }
          ]
        }
      ]
    },
    {
      "kind": "electrolytic_capacitor",
      "label": "C",
      "leadSpacing": 1,
      "matchMode": "all",
      "match": [
        {
          "any": [
            { "field": "refPrefix", "equals": "C" },
            { "field": "category", "includes": "CAP" }
          ]
        },
        {
          "any": [
            { "field": "category", "includes": "ELECT" },
            { "field": "value", "includes": "UF" }
          ]
        }
      ]
    },
    {
      "kind": "radial_capacitor",
      "label": "C",
      "leadSpacing": 1,
      "match": [
        { "field": "refPrefix", "equals": "C" },
        { "field": "category", "includes": "CAP" }
      ]
    },
    {
      "kind": "dip",
      "label": "DIP",
      "rowSpacing": 3,
      "pinCountStrategy": "dipPackage",
      "matchMode": "all",
      "match": [
        { "field": "refPrefix", "equals": "U" },
        { "not": { "field": "packageName", "includes": "DIPSW" } },
        {
          "any": [
            { "field": "packageName", "matches": "^(?:P?DIP|SDIP)-?P?-?[0-9]+" },
            { "field": "packageName", "includes": "SO-" },
            { "field": "packageName", "includes": "SOIC" },
            { "field": "packageName", "matches": "^D0?[0-9]+$" },
            { "field": "packageName", "matches": "^DO[0-9]+$" },
            { "field": "packageName", "includes": "CASE751A" }
          ]
        }
      ]
    },
    {
      "kind": "dip",
      "label": "DIP",
      "rowSpacing": 3,
      "pinCountStrategy": "dipPackage",
      "matchMode": "all",
      "match": [
        { "field": "refPrefix", "equals": "U" },
        {
          "any": [
            { "field": "category", "matches": "^74" },
            { "field": "value", "matches": "^74[A-Z0-9_+-]*" }
          ]
        }
      ]
    },
    {
      "kind": "buzzer",
      "label": "BZ",
      "pinCountStrategy": "fixed2",
      "match": [
        { "field": "category", "includes": "BUZZER" },
        { "field": "value", "includes": "BUZZER" }
      ]
    },
    {
      "kind": "seven_segment_display",
      "label": "7SEG",
      "pinCountStrategy": "fixed8",
      "match": [
        { "field": "value", "includes": "SEVEN_SEG" },
        { "field": "value", "includes": "7SEG" }
      ]
    },
    {
      "kind": "alphanumeric_display",
      "label": "ALNUM",
      "pinCountStrategy": "fixed18",
      "match": [
        { "field": "value", "includes": "ALPHA_NUMERIC" },
        { "field": "value", "includes": "ALPHANUMERIC" }
      ]
    },
    {
      "kind": "slide_switch",
      "label": "SW",
      "pinCountStrategy": "fixed3",
      "match": [
        { "field": "value", "includes": "SPDT" },
        { "field": "packageName", "includes": "SPDT" }
      ]
    },
    {
      "kind": "pin_header",
      "label": "HDR",
      "pinCountStrategy": "fixed10",
      "match": [
        { "field": "category", "includes": "HEADERS_TEST" },
        { "field": "packageName", "includes": "1787234" }
      ]
    }
  ],
  "fallbackComponentMapping": {
    "kind": "pin_header",
    "label": "X",
    "pinCount": 2
  }
}
